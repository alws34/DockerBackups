# Installed by scripts/install.sh to /etc/systemd/system/homelab-takeout.service.
# Local overrides: `systemctl edit homelab-takeout` (do not edit this file in place).
[Unit]
Description=Homelab Takeout - scheduled API exports of self-hosted apps
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=homelab-takeout
Group=homelab-takeout
WorkingDirectory=/var/lib/homelab-takeout
Environment=PYTHONPATH=/opt/homelab-takeout
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/homelab-takeout/bw/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/homelab-takeout
Environment=CONFIG_FILE=/etc/homelab-takeout/services.json
Environment=ENV_FILE=/etc/homelab-takeout/.env
Environment=GOOGLE_CREDENTIALS_FILE=/etc/homelab-takeout/google-credentials.json
Environment=GOOGLE_TOKENS_FILE=/etc/homelab-takeout/google-tokens.json
Environment=BACKUP_ROOT=/var/lib/homelab-takeout/backups
Environment=STATE_ROOT=/var/lib/homelab-takeout/state
Environment=LOG_ROOT=/var/log/homelab-takeout
Environment=WEB_PORT=9100
# Values in .env (WEB_PORT, TZ, ALLOWED_HOSTS, ...) override the lines above.
EnvironmentFile=-/etc/homelab-takeout/.env
ExecStart=/opt/homelab-takeout/venv/bin/python /opt/homelab-takeout/app/main.py
Restart=on-failure
RestartSec=10

# ── Hardening (check: systemd-analyze security homelab-takeout) ──────────────
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# The GUI edits services.json and .env, so the config dir must be writable.
ReadWritePaths=/etc/homelab-takeout /var/lib/homelab-takeout /var/log/homelab-takeout
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
# MemoryDenyWriteExecute is deliberately NOT set: the Bitwarden CLI runs on
# Node.js, whose V8 JIT and WebAssembly need writable+executable memory.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
