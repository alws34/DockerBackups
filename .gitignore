# Your settings, secrets and data. Never tracked, so `git pull` can never overwrite or
# delete them (tests/test_user_data.py checks this). Bind-mounted into the container.
.env
config/*
!config/.gitkeep

# Runtime data
backups/
logs/
state/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env.local

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# OS artifacts
.DS_Store
Thumbs.db

# Node (only present inside Docker build; not committed)
node_modules/

# Claude Code agent worktrees
.claude/worktrees/

# Internal planning docs
docs/superpowers/
init_instructions.md
