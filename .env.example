TZ=Asia/Jerusalem

# ── Container user ───────────────────────────────────────────────────────────
# The container runs unprivileged as uid:gid 1000:1000. If ./backups, ./logs,
# ./state, ./config and .env belong to someone else, set their uid/gid here
# (run `id -u` and `id -g` on the host).
#PUID=1000
#PGID=1000

# ── Web GUI ──────────────────────────────────────────────────────────────────
# Only used when sign-in is off (AUTH_MODE=off): hostnames allowed to reach the GUI,
# comma-separated, e.g. takeout.home.lan. IP addresses and localhost always work. With
# sign-in on (the default) any hostname works, e.g. one you add in your reverse proxy.
ALLOWED_HOSTS=

# Sign-in: password (default) | proxy | off. Easiest to change in Settings → Sign-in.
AUTH_MODE=password
# proxy mode only: IPs/networks of your auth proxy, and the header carrying the user
AUTH_TRUSTED_PROXIES=
AUTH_PROXY_HEADER=Remote-User

# ── Vaultwarden ──────────────────────────────────────────────────────────────
VAULTWARDEN_URL=https://vault.your-domain.com

# From: Vaultwarden web UI → Account Settings → Security → API Key
BW_CLIENTID=user.xxxxxxxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Vaultwarden master password (never logged)
BW_PASSWORD=your-vaultwarden-master-password

# Separate password used to encrypt the exported JSON backup
# MUST differ from your master password
VAULTWARDEN_EXPORT_PASSWORD=your-separate-export-password

# ── Wiki.js ──────────────────────────────────────────────────────────────────
WIKIJS_URL=https://wiki.your-domain.com

# From: Wiki.js Administration → API Access → New API Key (read scope sufficient)
WIKIJS_API_TOKEN=your-wikijs-api-token

# ── Snipe-IT ─────────────────────────────────────────────────────────────────
SNIPEIT_URL=http://snipeit:80
# API token: Snipe-IT Settings → API → Create Token
SNIPEIT_API_KEY=your-snipeit-api-token

# ── Bar Assistant ─────────────────────────────────────────────────────────────
# Salt Rim reverse-proxy: https://yourdomain.tld/bar  |  Direct API container: http://bar-assistant:3000
BAR_ASSISTANT_URL=https://yourdomain.tld/bar
BAR_ASSISTANT_API_KEY=your-bar-assistant-api-key

# ── KitchenOwl ───────────────────────────────────────────────────────────────
KITCHENOWL_URL=http://kitchenowl:80
# Long-lived token: KitchenOwl Settings → Account → Long-Lived Tokens
KITCHENOWL_TOKEN=your-kitchenowl-long-lived-token

# ── Linkwarden ───────────────────────────────────────────────────────────────
LINKWARDEN_URL=http://linkwarden:3000
# Access token: Linkwarden Settings → Access Tokens → New Access Token
LINKWARDEN_ACCESS_TOKEN=your-linkwarden-access-token

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_URL=https://n8n.your-domain.com
# API key: n8n Settings → n8n API → Create an API key
N8N_API_KEY=your-n8n-api-key

# ── Karakeep ─────────────────────────────────────────────────────────────────
KARAKEEP_URL=http://karakeep:3000
# API key: Karakeep Settings → API Keys
KARAKEEP_API_KEY=your-karakeep-api-key

# ── Spoolman (no auth) ───────────────────────────────────────────────────────
SPOOLMAN_URL=https://spoolman.your-domain.com

# ── Immich (metadata only, not media) ────────────────────────────────────────
IMMICH_URL=https://immich.your-domain.com
# API key: Immich Account Settings → API Keys (read permissions)
IMMICH_API_KEY=your-immich-api-key

# ── Nginx Proxy Manager ──────────────────────────────────────────────────────
NPM_URL=http://127.0.0.1:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=your-npm-password

# ── AdGuard Home ─────────────────────────────────────────────────────────────
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=your-adguard-password

# ── qBittorrent ──────────────────────────────────────────────────────────────
# WebUI login: Tools → Options → Web UI → Authentication
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your-qbittorrent-password

# ── Destinations (all optional; easiest to set up in the GUI) ────────────────
# Each has <NAME>_ENABLED=true|false. Logins (Google, Microsoft) happen in the GUI.
GOOGLE_DRIVE_ENABLED=false
# Optional: upload into a specific folder the app created, instead of "Homelab Takeout"
GOOGLE_DRIVE_FOLDER_ID=

ONEDRIVE_ENABLED=false

SFTP_ENABLED=false
SFTP_HOST=nas.your-domain.lan
SFTP_PORT=22
SFTP_USERNAME=backup
SFTP_PASSWORD=
SFTP_PATH=/volume1/backups/homelab-takeout
# Set by the GUI when you confirm the server's host key on "Test connection"
SFTP_HOST_FINGERPRINT=

SMB_ENABLED=false
SMB_SERVER=nas.your-domain.lan
SMB_SHARE=backups
SMB_PATH=homelab-takeout
SMB_USERNAME=backup
SMB_PASSWORD=

LOCAL_FOLDER_ENABLED=false
LOCAL_FOLDER_PATH=/mnt/nas/homelab-takeout
